{
  "name": "@otrpg/server",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Game server for Open Tabletop RPG: rooms joined by code, one main screen and a phone controller per player.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./view": "./src/view.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/ws-transport": "^0.16.5",
    "@otrpg/engine": "0.1.0",
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "colyseus.js": "^0.16.22",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
